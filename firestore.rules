rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'holistikprofesi47@gmail.com' ||
        request.auth.token.email == 'holistikundip@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isClinicalStaff() {
      return isAdmin();
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100;
    }

    function isValidAppointment(data) {
      return data.bookingCode is string && data.bookingCode.size() <= 50 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.therapyId is string && data.therapyId.size() <= 100 &&
             data.date is string && data.date.size() <= 30 &&
             data.status in ['Menunggu', 'Terjadwal', 'Selesai', 'Dibatalkan'];
    }

    function isValidProgressNote(data) {
      return data.patientId is string && data.patientId.size() <= 128 &&
             data.patientName is string && data.patientName.size() <= 100 &&
             data.therapyName is string && data.therapyName.size() <= 150 &&
             data.visitDate is string && data.visitDate.size() <= 30;
    }

    function isValidRegistration(data) {
      return data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100;
    }

    function isValidClinicalRecord(data) {
      return data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128 &&
             data.nurseInCharge is string && data.nurseInCharge.size() > 0 && data.nurseInCharge.size() <= 100;
    }

    function isValidContraindicationScreening(data) {
      return data.contraindicationScreening is map &&
             data.contraindicationScreening.highFever is bool &&
             data.contraindicationScreening.bleedingDisorderOrBloodThinner is bool &&
             data.contraindicationScreening.openWoundAtTherapyArea is bool;
    }

    function isSafeScreening(data) {
      return isValidContraindicationScreening(data) &&
             data.contraindicationScreening.highFever == false &&
             data.contraindicationScreening.bleedingDisorderOrBloodThinner == false &&
             data.contraindicationScreening.openWoundAtTherapyArea == false;
    }

    function isValidNurseClinicalRecord(data) {
      return data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128 &&
             data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 100 &&
             data.subjective is string && data.objective is string &&
             data.assessment is string && data.plan is string &&
             data.nurseName is string && data.nurseName.size() > 0 && data.nurseName.size() <= 150 &&
             data.profession == 'Perawat Penanggung Jawab / Ners';
    }

    // User Profiles collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidUser(incoming());
      allow delete: if isSignedIn();
    }

    // Registrations collection (Form Pendaftaran Akun Baru DipoCare)
    match /registrations/{registrationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidRegistration(incoming());
      allow delete: if isAdmin();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAppointment(incoming()) &&
        (incoming().status in ['Menunggu', 'Dibatalkan']) &&
        !incoming().keys().hasAny([
          'contraindicationScreening', 'contraindicationSafe',
          'contraindicationAssessedBy', 'contraindicationAssessedAt'
        ]);
      allow update: if isSignedIn() && isValidAppointment(incoming()) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'contraindicationScreening', 'contraindicationSafe',
            'contraindicationAssessedBy', 'contraindicationAssessedAt'
          ]) || (isClinicalStaff() && isValidContraindicationScreening(incoming()))
        ) &&
        (
          !(incoming().status in ['Terjadwal', 'Selesai']) ||
          (
            isClinicalStaff() &&
            incoming().contraindicationSafe == true &&
            isSafeScreening(incoming())
          )
        );
      allow delete: if isSignedIn();
    }

    // Clinical Progress Notes collection
    match /clinical_progress_notes/{noteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidProgressNote(incoming());
      allow delete: if isSignedIn();
    }

    // Clinical Records collection (Catatan Perawatan Terapis / Rekam Medis)
    match /clinical_records/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidClinicalRecord(incoming());
      allow delete: if isAdmin();
    }

    // Private SOAP records created by the responsible nurse; never exposed to patient accounts.
    match /nurse_clinical_records/{recordId} {
      allow read: if isClinicalStaff();
      allow create, update: if isClinicalStaff() && isValidNurseClinicalRecord(incoming());
      allow delete: if isClinicalStaff();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
